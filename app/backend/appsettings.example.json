{
  "ApiSettings": {
    "Issuer": "CloudianAPI",
    "Audience": "CloudianClient"
  },
  "AppSettings": {
    "AllowedEmailDomains": "@cloud.io,@cloud.bookstore.io"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "UpstashRedis": {
    "RestUrl": "",
    "RestToken": ""
  },
  "Jwt": {
    "AccessSecret": { "Key": "" },
    "RefreshSecret": { "Key": "" },
    "VerifyRegisterSecret": { "Key": "" },
    "ResetPasswordSecret": { "Key": "" }
  },
  "AuthSecurity": {
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeMinutes": 10080,
    "VerificationTokenLifetimeMinutes": 1024,
    "ResetPasswordTokenLifetimeMinutes": 15
  },
  "AuthCookies": {
    "AccessCookieName": "cloudbook_access",
    "RefreshCookieName": "cloudbook_refresh",
    "CsrfHeaderName": "X-CSRF-Token",
    "RequireSecure": true,
    "AllowedOrigins": [
      "https://cloudbook.cloudian.io.vn",
      "http://localhost:5173"
    ]
  },
  "Email": {
    "FromAddress": "no-reply@example.com",
    "FromName": "Cloud Bookstore",
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    "UseStartTls": true,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "FrontendBaseUrl": "https://app.example.com",
    "VerifyEmailPath": "/verify-register",
    "ResetPasswordPath": "/reset-password"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "RootFolder": "cloud-bookstore",
    "FolderMode": "DYNAMIC",
    "PublicUploadPreset": "book-images-signed",
    "AuthenticatedUploadPreset": "evidence-images-signed"
  }
}
