{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Email": {
    "FromAddress": "no-reply@cloudbook.local",
    "FromName": "Cloud Bookstore",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "UseStartTls": false,
    "FrontendBaseUrl": "http://localhost:5173",
    "VerifyEmailPath": "/verify-register",
    "ResetPasswordPath": "/reset-password"
  },
  "AuthSecurity": {
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeMinutes": 10080,
    "VerificationTokenLifetimeMinutes": 1024,
    "ResetPasswordTokenLifetimeMinutes": 15
  },
  "AuthCookies": {
    "AccessCookieName": "cloudbook_access",
    "RefreshCookieName": "cloudbook_refresh",
    "CsrfHeaderName": "X-CSRF-Token",
    "RequireSecure": true,
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4000",
      "http://localhost:5020",
      "https://localhost:7073",
      "http://127.0.0.1:4000"
    ]
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "PublicEndpoint": "",
    "AccessKey": "cloudian",
    "SecretKey": "cloudian",
    "BucketName": "cloud-bookstore",
    "UseSsl": false,
    "MaxFileSizeMb": 10,
    "PresignedUrlExpirySeconds": 300,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp", "application/pdf" ]
  }
}
