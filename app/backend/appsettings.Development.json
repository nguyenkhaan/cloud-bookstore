{
  "AppSettings": {
    "AllowedEmailDomains": "@cloud.io,@cloud.bookstore.io"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=cloud_bookstore;Username=postgres;Password=postgrespassword"
  },
  "UpstashRedis": {
    "RestUrl": "http://localhost:8079",
    "RestToken": "local_redis_token"
  },
  "Jwt": {
    "ResetPasswordSecret": {
      "Key": "9e1f5b67-a8b2-44b5-a197-af92d17b4cbe-reset-password-secret-key"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Email": {
    "FromAddress": "no-reply@cloudbook.local",
    "FromName": "Cloud Bookstore",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "UseStartTls": false,
    "FrontendBaseUrl": "http://localhost:5173",
    "VerifyEmailPath": "/verify-register",
    "ResetPasswordPath": "/reset-password"
  },
  "AuthSecurity": {
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeMinutes": 10080,
    "VerificationTokenLifetimeMinutes": 1024,
    "ResetPasswordTokenLifetimeMinutes": 15
  },
  "AuthCookies": {
    "AccessCookieName": "cloudbook_access",
    "RefreshCookieName": "cloudbook_refresh",
    "CsrfHeaderName": "X-CSRF-Token",
    "RequireSecure": false,
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4000",
      "http://localhost:5020",
      "https://localhost:7073",
      "http://127.0.0.1:4000"
    ]
  }
}
