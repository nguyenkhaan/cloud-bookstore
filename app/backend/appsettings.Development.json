{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false"
  },
  "ApiSettings": {
    "Issuer": "cloudbook-api",
    "Audience": "cloudbook-web"
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "FailWindowMinutes": 15,
    "LockMinutes": 15,
    "AccessMinutes": 15,
    "RefreshDays": 7
  }
}
